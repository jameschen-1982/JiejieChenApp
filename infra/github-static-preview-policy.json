{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListPreviewBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::cjj-prod-fu4c-static-site"
    },
    {
      "Sid": "UploadAndRemovePreviewObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::cjj-prod-fu4c-static-site/*"
    },
    {
      "Sid": "InvalidateStaticSiteDistributions",
      "Effect": "Allow",
      "Action": "cloudfront:CreateInvalidation",
      "Resource": [
        "arn:aws:cloudfront::773631419510:distribution/EMKZKS39L7D0R",
        "arn:aws:cloudfront::773631419510:distribution/E1DQTNP78PXVF5"
      ]
    }
  ]
}
