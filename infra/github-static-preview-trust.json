{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowMainBranchActions",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::773631419510:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": "repo:jameschen-1982/JiejieChenApp:ref:refs/heads/main"
        }
      }
    }
  ]
}
